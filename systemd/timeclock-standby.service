[Unit]
Description=Timeclock standby screen: Firefox on the status page, terminal 7
After=timeclock-status.service

[Service]
Type=simple
# standby.sh quits the boot splash itself, once it has switched terminals.
ExecStart=/opt/timeclock-standby/standby.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
