[Unit]
Description=Timeclock screen watcher: shows or hides the clock window
# First of the display units: it never switches away from the boot splash, so it can't take the splash's screen.
Before=timeclock-status.service

[Service]
Type=simple
ExecStart=/usr/bin/timeclock-watcher
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
