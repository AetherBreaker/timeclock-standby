[Unit]
Description=Timeclock screen watcher: shows the clock's terminal or the standby screen's
# First of the standby units: it never switches to an unclaimed terminal, so it can't take the boot splash's screen.
Before=timeclock-status.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/timeclock-watcher
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
