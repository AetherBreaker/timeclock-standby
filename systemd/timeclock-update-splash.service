# The first boot into a host update (the watcher's release still awaits its check): the boot splash says the update is
# installing, as the reboot splash did, until the display takes over.
[Unit]
Description=Timeclock boot splash: say a system update is installing
DefaultDependencies=no
After=plymouth-start.service local-fs.target
Before=timeclock-display.service
ConditionPathExists=/var/lib/timeclock-watcher/pending

[Service]
Type=oneshot
ExecStart=-/usr/bin/plymouth change-mode --updates

[Install]
WantedBy=multi-user.target
